# NodeGoat Environment Variables
# Copy this file to .env and fill in actual values
# NEVER commit .env files with actual secrets!

# Application Secrets
APP_SECRET=your_app_secret_here
SESSION_SECRET=your_session_secret_here
AUTH_TOKEN_SECRET=your_auth_token_secret_here

# Database
DB_SECRET=your_database_secret_here
DB_PASSWORD=your_database_password_here
API_KEY=your_api_key_here

# Test Environment (use different values for testing)
TEST_SECRET=test_secret_value
TEST_SESSION_SECRET=test_session_secret

# Generate strong secrets using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Example output:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 5d9e8f7c3a1b2e4f6d8c9a0b3e5f7d9e8c1a3b5d7f9e0c2a4b6d8e0f2a4c6d8
